# Copy to .env and adjust. .env is git-ignored: never commit it.

# Exact origin of the React front end (React dev server). Comma-separate if more than one.
ALLOWED_ORIGINS=http://localhost:3000

# SHA-256 of model/phishing_rf.joblib, printed by train_model.py.
# The server refuses to load a model file that does not match.
MODEL_SHA256=d6761005d2a5b2de0df40196b21c641ec0a2a761097ba9134319969cd1f0abc3

MAX_URL_LENGTH=2048
MAX_BODY_BYTES=4096
MAX_INFLIGHT_CHECKS=32
MAX_CONCURRENT_INFERENCES=4
QUEUE_WAIT_SECONDS=0.5

# Demo switches for the video only. Keep both "on".
DOS_DEFENCE=on
UNICODE_NORMALISATION=on
